# Trained controls: 3.7 GB of .pt, regenerable with `python <exp>.py train`.
# Only the ckpt/ directory is ignored.  A .pt sitting anywhere else IS tracked,
# so a checkpoint trained on another machine can be pushed to the repo root and
# then moved into ckpt/ locally.
ckpt/

# Run logs.
*.log

# Upstream R-ASBS clone, kept locally for reference only.
# Frozen commit bb71d1496468658f4ff1c9995773968fd12706a8 of
# github.com/mattiamosso/Hard-Constrained-Sampling-on-Embedded-Riemannian-Manifold-via-Adjoint-Schrodinger-Bridges
rasbs_ref/

__pycache__/
*.pyc

# GB1 raw data (6.7 MB of Olson et al. supplements).
# Download instructions are in data/gb1/README.md.
data/gb1/*.xlsx

# Pinned upstream MetaDNS clone (CuAu cluster-expansion energy oracle).
# Commit + file hashes are recorded in data/cuau/PROVENANCE.md.
external/

# multiseed worker pool scratch state.
.multiseed_pool/

# Generated sample archives (large .npz).
samples/
reference/

# generated CuAu CE caches (rebuilt deterministically by `python -m iasbs.cuau validate`)
data/cuau/ce_tables_*.npz
data/cuau/cubic_perm_*.npy
data/cuau/symperms_*.npy
